QPushButton {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #334155;
    font-weight: 700;
    padding: 8px 14px;
}
QPushButton:hover {
    background: #f8fafc;
    border-color: #94a3b8;
}
QPushButton#btnLogout {
    background: #0f172a;
    border: 1px solid #0f172a;
    color: #ffffff;
}
QPushButton#btnLogout:hover {
    background: #1e293b;
}
QPushButton#btnChangePassword {
    background: #0f766e;
    border-color: #0f766e;
    color: #ffffff;
}
QPushButton#btnChangePassword:hover {
    background: #115e59;
}
QPushButton#btnPillActive, QPushButton#btnTatCa:checked, QPushButton#btnHK202425:checked,
QPushButton#btnHK202324:checked, QPushButton#btnHK1202324:checked {
    background: #0f766e;
    border-color: #0f766e;
    color: #ffffff;
}
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #dde6ef;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    min-width: 118px;
    min-height: 38px;
    margin: 0 8px 0 0;
    padding: 8px 14px;
    font-weight: 800;
}
QTabBar::tab:selected {
    background: #0f766e;
    color: #ffffff;
    border-color: #0f766e;
}
QLineEdit {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #111827;
    padding: 9px 12px;
}
QLineEdit:focus {
    border: 2px solid #0f766e;
    padding: 8px 11px;
}
QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: #ccfbf1;
    selection-color: #0f172a;
}
QHeaderView::section {
    background: #f1f5f9;
    color: #334155;
    border: 0;
    border-bottom: 1px solid #e2e8f0;
    padding: 11px 8px;
    font-weight: 800;
}
QProgressBar#pbPasswordStrength {
    background: #e2e8f0;
    border: 0;
    border-radius: 5px;
    max-height: 10px;
}
QProgressBar#pbPasswordStrength::chunk {
    background: #0f766e;
    border-radius: 5px;
}</string>

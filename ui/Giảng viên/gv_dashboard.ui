  <property name="styleSheet">
   <string notr="true">QWidget { background:#f3f6f8; color:#1e293b; font-size:14px; }
QFrame#topBar { background:#075985; border-radius:12px; }
QLabel#lblBrand { color:#ffffff; font-size:22px; font-weight:700; background:transparent; }
QLabel#lblGiangVien { color:#e0f2fe; font-weight:600; background:transparent; padding-right:4px; }
QPushButton#btnLogout {
  background: rgba(255,255,255,0.1);
  color: #ffffff;
  border: 1px solid rgba(186,230,253,0.85);
  border-radius: 8px;
  padding: 6px 16px;
  font-weight: 600;
  min-height: 34px;
}
QPushButton#btnLogout:hover {
  background: rgba(255,255,255,0.2);
  border-color: #ffffff;
}
QPushButton#btnLogout:pressed {
  background: rgba(7, 45, 70, 0.45);
}
QLabel#lblHeader { color:#0f172a; font-size:18px; font-weight:700; margin:6px 0; }
QFrame#panel { background:#ffffff; border:1px solid #dbe4ea; border-radius:12px; }
QPushButton { background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:8px 12px; font-weight:600; }
QPushButton:hover { background:#f8fafc; }
QTabWidget::pane { border: 1px solid #dbe4ea; border-radius: 10px; background:#ffffff; }
QTabBar::tab { background:#075985; color:#e0f2fe; border:1px solid #7dd3fc; border-top-left-radius:8px; border-top-right-radius:8px; padding:8px 14px; min-width:120px; }
QTabBar::tab:selected { background:#ffffff; color:#0c4a6e; border:1px solid #bae6fd; font-weight:700; }
QPushButton#cardSoLop, QPushButton#cardSoMon, QPushButton#cardTongSV, QPushButton#cardChuaNhap,
QPushButton#cardTongSv, QPushButton#cardDaCoDiem, QPushButton#cardChuaNhapSv, QPushButton#cardRotMon,
QPushButton#cardBaoCaoTongSv, QPushButton#cardBaoCaoTiLeDau, QPushButton#cardBaoCaoDtbCao, QPushButton#cardBaoCaoCanChuY {
 background:#ffffff; border:1px solid #dbe4ea; border-radius:12px; text-align:left; padding:12px; font-weight:700;
}
QLineEdit, QComboBox { background:#ffffff; border:1px solid #cbd5e1; border-radius:10px; padding:8px; }
QTableWidget { background:#ffffff; border:1px solid #dbe4ea; border-radius:10px; gridline-color:#ecf0f4; alternate-background-color:#f8fafc; }
QHeaderView::section { background:#eef6ff; color:#0f4c81; border:none; border-bottom:1px solid #d5e6f7; padding:8px; font-weight:700; }
QLabel#infoBanner, QLabel#lblSvNote, QLabel#lblBaoCaoScope, QLabel#lblFormula, QLabel#lblLockNotice {
 background:#ecfeff; border:1px solid #bae6fd; border-radius:10px; padding:8px; color:#0f4c81;
}</string>
